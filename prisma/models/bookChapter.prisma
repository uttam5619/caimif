/// Book chapter publication record authored or co-authored by CAIMIF researchers.
model BookChapter {
  /// Unique identifier for the book chapter publication.
  id String @id @default(cuid())

  /// Year of publication.
  year Int?

  /// Research domain/field of study.
  domain String?

  /// Title of the book chapter.
  chapterTitle String @map("chapter_title") @db.Text

  /// Name of the book.
  bookName String @map("book_name") @db.Text

  /// CAIMIF-affiliated authors involved in the chapter.
  authorFromCaimif String? @map("author_from_caimif") @db.Text

  /// External or other co-authors.
  otherAuthors String? @map("other_authors") @db.Text

  /// Publishing organization.
  publisher String?

  /// Indexing body/status (e.g., Scopus, Web of Science).
  indexing String?

  /// Book chapter quartile ranking (Q1, Q2, Q3, Q4), if applicable.
  quartile String?

  /// Direct web link or DOI to the published chapter.
  weblink String? @db.Text

  /// Timestamp when the record was created.
  createdAt DateTime @default(now()) @map("created_at")

  /// Timestamp when the record was last updated.
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([year])
  @@index([domain])
  @@map("book_chapters")
}