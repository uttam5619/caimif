/// Patent record authored or co-authored by CAIMIF researchers.
model Patent {
  /// Unique identifier.
  id String @id @default(cuid())

  /// Year of publication or grant.
  year Int

  /// Research domain/field of study.
  domain String

  /// Full title of the patent.
  title String @db.Text

  /// Current patent status.
  status PatentStatus

  /// Names of the patent inventors.
  nameOfInventors String @map("name_of_inventors") @db.Text

  /// Name of the patent agency.
  patentAgency String @map("patent_agency")

  /// Country where the patent was filed or granted.
  country String

  /// Patent grant number.
  grantNumber String? @unique @map("grant_number")

  /// Timestamp when the record was created.
  createdAt DateTime @default(now()) @map("created_at")

  /// Timestamp when the record was last updated.
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Indexes for faster searching and filtering.
  @@index([title(length: 255)])
  @@index([year])
  @@index([domain])
  @@index([status])
  @@map("patents")
}

/// Patent application/grant status.
enum PatentStatus {
  PUBLISHED
  GRANTED
}